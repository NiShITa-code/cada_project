# Copy to .env and fill LLM_API_KEY. See REPRODUCE.md §3. The .env is gitignored (never commit the key).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...                               # your OpenRouter (or OpenAI-compatible) key
JUDGE_MODEL=openai/gpt-4o                            # for byte-exact repro pin a snapshot: openai/gpt-4o-2024-08-06
LLAMAGUARD_MODEL=meta-llama/llama-guard-4-12b
ENABLE_JUDGE=1
